{
  "base_url": "https://api.company-information.service.gov.uk",
  "auth": {
    "method": "http_basic",
    "username": "api_key",
    "password": "empty",
    "docs": "https://developer.company-information.service.gov.uk/"
  },
  "rate_limit": {
    "requests_per_five_minutes": 600,
    "note": "Rate limits apply per API key. 429 responses indicate throttling."
  },
  "endpoints": {
    "search_companies": {
      "method": "GET",
      "path": "/search/companies",
      "description": "Search for companies by name or number.",
      "params": {
        "q": {
          "type": "string",
          "required": true,
          "description": "Company name or number search query"
        },
        "items_per_page": {
          "type": "integer",
          "required": false,
          "default": 20,
          "max": 100,
          "description": "Number of results per page"
        },
        "start_index": {
          "type": "integer",
          "required": false,
          "default": 0,
          "description": "Offset for pagination"
        }
      },
      "response_key": "items"
    },
    "get_company_profile": {
      "method": "GET",
      "path": "/company/{company_number}",
      "description": "Get the full profile for a specific company.",
      "params": {},
      "response_key": null
    },
    "get_officers": {
      "method": "GET",
      "path": "/company/{company_number}/officers",
      "description": "List officers (directors, secretaries) for a company.",
      "params": {
        "items_per_page": {
          "type": "integer",
          "required": false,
          "description": "Number of results per page"
        },
        "start_index": {
          "type": "integer",
          "required": false,
          "description": "Offset for pagination"
        },
        "order_by": {
          "type": "string",
          "required": false,
          "enum": [
            "appointed_on",
            "resigned_on",
            "surname"
          ],
          "description": "Sort order for results"
        }
      },
      "response_key": "items"
    },
    "get_pscs": {
      "method": "GET",
      "path": "/company/{company_number}/persons-with-significant-control",
      "description": "List persons with significant control (beneficial owners).",
      "params": {
        "items_per_page": {
          "type": "integer",
          "required": false,
          "description": "Number of results per page"
        },
        "start_index": {
          "type": "integer",
          "required": false,
          "description": "Offset for pagination"
        },
        "register_view": {
          "type": "boolean",
          "required": false,
          "description": "Show only active PSCs when true"
        }
      },
      "response_key": "items"
    },
    "get_filing_history": {
      "method": "GET",
      "path": "/company/{company_number}/filing-history",
      "description": "List filing history for a company.",
      "params": {
        "category": {
          "type": "string",
          "required": false,
          "description": "Filter by filing category (e.g. accounts, confirmation-statement)"
        },
        "items_per_page": {
          "type": "integer",
          "required": false,
          "description": "Number of results per page"
        },
        "start_index": {
          "type": "integer",
          "required": false,
          "description": "Offset for pagination"
        }
      },
      "response_key": "items"
    },
    "document_metadata": {
      "method": "GET",
      "path": "/document/{document_id}",
      "base": "document_api",
      "description": "Fetch Document API metadata (MIME types, pages, content_length).",
      "params": {},
      "response_key": null
    },
    "document_content": {
      "method": "GET",
      "path": "/document/{document_id}/content",
      "base": "document_api",
      "description": "Fetch document bytes. Returns 302 to external storage; drop Authorization on redirect.",
      "headers": {
        "Accept": "Desired MIME type (e.g. application/pdf)"
      },
      "params": {},
      "response_key": null
    },
    "charges": {
      "method": "GET",
      "path": "/company/{company_number}/charges",
      "description": "List registered mortgages and charges for a company (404 when none exist).",
      "params": {
        "items_per_page": {
          "type": "integer",
          "required": false,
          "default": 25,
          "max": 100,
          "description": "Number of results per page"
        },
        "start_index": {
          "type": "integer",
          "required": false,
          "default": 0,
          "description": "Offset for pagination"
        }
      },
      "response_key": "items"
    },
    "charge_item": {
      "method": "GET",
      "path": "/company/{company_number}/charges/{charge_id}",
      "description": "Get details for a single registered charge.",
      "params": {},
      "response_key": null
    },
    "insolvency": {
      "method": "GET",
      "path": "/company/{company_number}/insolvency",
      "description": "Get statutory insolvency cases for a company (404 when no insolvency history exists).",
      "params": {},
      "response_key": "cases"
    },
    "filing_item": {
      "method": "GET",
      "path": "/company/{company_number}/filing-history/{transaction_id}",
      "description": "Get full metadata for a single filing transaction.",
      "params": {},
      "response_key": null
    },
    "search_officers": {
      "method": "GET",
      "path": "/search/officers",
      "description": "Search for officers nationwide by name.",
      "params": {
        "q": {
          "type": "string",
          "required": true,
          "description": "Officer name search query"
        },
        "items_per_page": {
          "type": "integer",
          "required": false,
          "default": 10,
          "max": 50,
          "description": "Number of results per page"
        },
        "start_index": {
          "type": "integer",
          "required": false,
          "default": 0,
          "description": "Offset for pagination"
        }
      },
      "response_key": "items"
    },
    "officer_appointments": {
      "method": "GET",
      "path": "/officers/{officer_id}/appointments",
      "description": "List cross-company appointments for an officer.",
      "params": {
        "filter": {
          "type": "string",
          "required": false,
          "enum": [
            "active"
          ],
          "description": "Filter appointments server-side (pass 'active' for current directorships)"
        },
        "items_per_page": {
          "type": "integer",
          "required": false,
          "default": 20,
          "max": 50,
          "description": "Number of results per page"
        },
        "start_index": {
          "type": "integer",
          "required": false,
          "default": 0,
          "description": "Offset for pagination"
        }
      },
      "response_key": "items"
    }
  },
  "v2_planned": [
    "registers",
    "search_disqualified_officers"
  ],
  "document_api_base_url": "https://document-api.company-information.service.gov.uk"
}
